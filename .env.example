# MongoDB Atlas — required
# Prefer the non-SRV host list if Windows DNS fails with querySrv ECONNREFUSED
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/karachi-toy-shop?retryWrites=true&w=majority

# Cloudinary (optional until image upload UI is live)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin — CHANGE THESE before any real deploy
# Dev: plaintext password OK
# Production: ADMIN_PASSWORD MUST be a bcrypt hash (starts with $2a$ / $2b$)
ADMIN_EMAIL=replace-with-your-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Payments — launch COD-only first (recommended)
# Set both to true only after real JazzCash/PayFast integration is done
ENABLE_ONLINE_PAYMENTS=false
NEXT_PUBLIC_ENABLE_ONLINE_PAYMENTS=false
# Never enable in production
ALLOW_DEV_PAYMENT_BYPASS=false

# Optional order confirmation email (Resend)
RESEND_API_KEY=
RESEND_FROM=Karachi Toy Shop <onboarding@resend.dev>

# WhatsApp business number (country code, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=923313956602
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Karachi Toy Shop
NEXT_PUBLIC_WHATSAPP_NUMBER=923313956602

# Upstash Redis - distributed rate limiting (REQUIRED in production)
# Sign up at https://upstash.com and create a Redis DB, then set these in
# Vercel > Project > Settings > Environment Variables. Without them, rate
# limiting falls back to per-instance in-memory buckets (decorative in prod).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

