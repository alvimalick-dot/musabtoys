# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/karachi-toy-shop?retryWrites=true&w=majority

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin login (change in production)
ADMIN_EMAIL=admin@karachitoys.pk
ADMIN_PASSWORD=ChangeMe123!
ADMIN_JWT_SECRET=super-secret-jwt-key-change-this

# Payment gateways (optional — COD works without these)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Karachi Toy Shop
